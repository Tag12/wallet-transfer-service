PORT=3000
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet
JWT_SECRET=change-me-in-production

# Set DB_SSL=true when DATABASE_URL points at a managed Postgres that requires SSL
# (e.g. Neon's direct/unpooled connection string). Leave unset/false for local
# Docker Postgres, which has no SSL cert configured.
DB_SSL=false

# Betterstack (Logtail) source token — when set, logs are shipped there in addition
# to stdout, giving a public logs view. Leave unset for local dev/tests.
LOGTAIL_SOURCE_TOKEN=
